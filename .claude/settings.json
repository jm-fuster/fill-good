{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-push-build.mjs\"",
            "timeout": 900,
            "statusMessage": "Comprobando el build antes del push…"
          }
        ]
      }
    ]
  }
}
