# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se sube a git.

# --- Supabase (Fase 1) ---
# Dashboard del proyecto → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública para el navegador. Los proyectos nuevos la muestran como
# "Publishable key" (sb_publishable_...); en proyectos antiguos es la "anon key".
# El código acepta cualquiera de las dos variables.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role (SECRETA, solo servidor): la usa el cron de caducidades sin
# sesión de usuario, SALTÁNDOSE la RLS. Su fuga anula toda la seguridad por hogar
# — trátala como la joya de la corona y rótala si se expone. Dashboard → Settings
# → API Keys (hoy se muestra como "secret key", sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk (Fase 1) ---
# Las escribe automáticamente `clerk init` en .env.local.
# Dashboard de Clerk → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Rutas de auth (valores por defecto de nuestro proyecto)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# (Opcional) Orígenes autorizados para reforzar la validación del token de Clerk
# frente a reuso entre orígenes. Coma-separado, con tu dominio de producción:
# CLERK_AUTHORIZED_PARTIES=https://tu-dominio.com,https://www.tu-dominio.com

# --- Cron: resumen diario de caducidades (push) ---
# Secreto que Vercel Cron envía como `Authorization: Bearer $CRON_SECRET`. Sin él,
# /api/push/caducidades responde 401 a todo (cerrado por defecto). Genera uno
# largo y aleatorio, p. ej.:  openssl rand -hex 32
CRON_SECRET=

# --- IA: Gemini free tier (Fases 4 y 6) ---
# Crea una API key gratuita (sin tarjeta) en https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Ids de modelo por tarea (opcional; hay defaults en src/lib/ai/models.ts).
# Cambiar de modelo/proveedor no requiere tocar código de features.
# AI_MODEL_RECEIPTS=gemini-flash-lite-latest
# AI_MODEL_MENUS=gemini-flash-latest

# --- Notificaciones Web Push (M10c) ---
# Genera el par UNA vez con:  npx web-push generate-vapid-keys
# NO regeneres las claves luego: invalidaría todas las suscripciones existentes.
# Mientras estén vacías, el push queda DESACTIVADO (la app funciona igual).
# Clave pública (también la usa el navegador al suscribirse):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Clave privada (SECRETA, solo servidor):
VAPID_PRIVATE_KEY=
# Contacto para el servicio push (tu email en formato mailto:):
VAPID_SUBJECT=mailto:jorge.molina@wakyma.com
